{
  "name": "gigstaxcf",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "@types/node": "^26.4.1",
      "varlock": "1.18.0",
      "@cloudflare/workers-types": "^5.20260906.1",
      "better-auth": "1.7.7",
      "evlog": "^2.28.1",
      "lucide-react": "^1.41.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "@tanstack/react-form": "^1.33.5",
      "@polar-sh/better-auth": "^1.8.4",
      "@types/react-dom": "^19.2.7",
      "@better-auth/expo": "1.7.7",
      "drizzle-orm": "1.0.0-rc.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native --",
    "db:push": "turbo run db:push -F @gigstaxcf/db --",
    "db:studio": "turbo run db:studio -F @gigstaxcf/db --",
    "db:generate": "turbo run db:generate -F @gigstaxcf/db --",
    "db:migrate": "turbo run db:migrate -F @gigstaxcf/db --",
    "deploy": "turbo run deploy -F @gigstaxcf/infra --",
    "destroy": "turbo run destroy -F @gigstaxcf/infra --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@gigstaxcf/config": "workspace:*",
    "@types/node": "catalog:",
    "lefthook": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "ultracite": "7.11.0",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.3.3"
}
